{
  "mcpServers": {
    "mcd": {
      "url": "https://mcp.mcd.cn",
      "headers": {
        "Authorization": "Bearer ${MCD_MCP_TOKEN}"
      },
      "lifecycle": "lazy",
      "disabled": false,
      "connectTimeoutSeconds": 15,
      "requestTimeoutSeconds": 60,
      "reconnectDelaySeconds": 5,
      "yuki": {
        "scope": "mcp.mcd",
        "summary": "麦当劳菜单、门店、优惠券、订单和积分",
        "tags": ["麦当劳", "点餐", "优惠券", "门店"]
      }
    },
    "netease_music": {
      "command": "python",
      "args": ["-m", "netease_music_mcp"],
      "cwd": ".",
      "env": {
        "NETEASE_COOKIE": "${NETEASE_COOKIE}"
      },
      "lifecycle": "lazy_keep_alive",
      "includeTools": [],
      "excludeTools": [],
      "yuki": {
        "scope": "mcp.netease_music",
        "summary": "歌曲、歌手、专辑、歌单和歌词",
        "tags": ["音乐", "网易云", "歌曲", "歌单"]
      }
    }
  }
}
